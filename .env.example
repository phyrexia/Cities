# Cities Social Simulator — Environment Variables

# ─── Server ──────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cities:cities_dev@localhost:5432/cities?sslmode=disable
REDIS_URL=redis://localhost:6379

# ─── Heartbeat ────────────────────────────────────────────────────────────────
# 10m = production | 2m = development | 30s = testing
HEARTBEAT_INTERVAL=20m

# ─── LLM Backend (choose ONE) ─────────────────────────────────────────────────

# Option 1: Anthropic Claude (best quality)
#LLM_BACKEND=ANTHROPIC
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-opus-4-6

# Option 2: OpenRouter (200+ models, one API key)
 LLM_BACKEND=OPENROUTER
 OPENROUTER_API_KEY=sk-...
 OPENROUTER_MODEL=google/gemini-2.5-flash-lite-preview-09-2005
# Other models available on OpenRouter:
#   google/gemini-flash-1.5          (fast + cheap)
#   meta-llama/llama-3.1-70b-instruct (open source)
#   mistralai/mixtral-8x7b-instruct  (open source)
#   google/gemma-2-9b-it:free        (free tier)

# Option 3: Local LLM (Ollama, LM Studio, Jan.ai, etc.)
# LLM_BACKEND=LOCAL
# LOCAL_LLM_URL=http://localhost:11434/v1   # Ollama default
# LOCAL_LLM_MODEL=llama3                    # or mistral, phi3, gemma2, etc.
#
# To run Ollama locally:
#   brew install ollama  (or apt/yum)
#   ollama pull llama3
#   ollama serve
